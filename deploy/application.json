{
  "schemaVersion": 1,
  "id": "idea-notes",
  "repository": "https://github.com/purduepete/idea-notes.git",
  "database": {
    "engine": "postgresql",
    "name": "idea_notes",
    "connectionEnvironment": "DATABASE_URL",
    "backendEnvironment": "STORAGE_BACKEND",
    "schemaVersion": 3,
    "migrationsDirectory": "deploy\\postgresql",
    "backupFormat": "custom"
  },
  "runtime": { "kind": "node", "minimumVersion": "22.12.0" },
  "build": {
    "commands": [
      { "tool": "npm", "arguments": ["ci"], "workingDirectory": "." },
      { "tool": "npm", "arguments": ["run", "build"], "workingDirectory": "." },
      { "tool": "npm", "arguments": ["prune", "--omit=dev", "--ignore-scripts"], "workingDirectory": "." }
    ]
  },
  "launch": {
    "entrypoint": "dist-server\\server\\main.js",
    "arguments": [],
    "port": 8802,
    "environment": {
      "PORT": "8802",
      "STORAGE_BACKEND": "postgresql",
      "SOLUTIONS_SOURCE": "http://127.0.0.1:18798/sites.json",
      "ALLOWED_ORIGINS": "https://idea-notes.jimlertech.com,https://jimbrownhome1.tail8ad282.ts.net:8802,http://127.0.0.1:8802"
    },
    "secretFile": "app.env",
    "stopFileEnvironment": "SOLUTIONDEPLOY_STOP_FILE"
  },
  "readiness": { "path": "/api/health", "expected": { "ok": true }, "timeoutSeconds": 60 },
  "state": [],
  "managedState": [],
  "routes": [{ "hostname": "idea-notes.jimlertech.com" }],
  "source": { "host": "jimbrownhome1", "root": "C:\\ProgramData\\SolutionDeploy\\apps\\idea-notes", "tasks": [] }
}
